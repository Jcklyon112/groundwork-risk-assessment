# Copy to .env to enable the "Ask the engine" agent (the one non-keyless layer).
# All the data adapters are keyless and work without this.

# Anthropic API key — required only for POST /api/ask (the tool-using agent).
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides:
# AGENT_MODEL=claude-opus-4-8     # the model the agent runs on
# PORT=8787                        # backend API port
